# Caddy INTERNO do container: só serve os arquivos estáticos na porta 8080.
# HTTPS, HSTS e o domínio ficam no Caddy central (ver caddy-central.snippet).
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		X-Robots-Tag "noindex, nofollow"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), autoplay=(self \"https://www.youtube-nocookie.com\"), encrypted-media=(self \"https://www.youtube-nocookie.com\"), picture-in-picture=(self \"https://www.youtube-nocookie.com\"), fullscreen=(self \"https://www.youtube-nocookie.com\")"
		# Sempre aplicadas (não quebram nada):
		Content-Security-Policy "object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		# CSP completa com hashes dos scripts inline, gerada no build (Report-Only ou aplicada).
		import /etc/caddy/csp.caddy
	}

	# Arquivos com hash no nome: cache "eterno".
	@hashed path /_next/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Imagens sem hash no nome (logo, capa): cache curto, para trocas aparecerem rápido.
	@images path *.svg *.jpg *.jpeg *.png *.webp *.avif
	header @images Cache-Control "public, max-age=3600, stale-while-revalidate=86400"

	# HTML: sempre revalida, para cada deploy aparecer na hora.
	@html not path /_next/static/* *.svg *.jpg *.jpeg *.png *.webp *.avif *.txt
	header @html Cache-Control "no-cache"

	try_files {path} {path}.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
