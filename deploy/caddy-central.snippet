# Cole no Caddyfile do Caddy CENTRAL da VM. Ele cuida do HTTPS (certificado automático) e do HSTS.
# Pré-requisitos: DNS de vsl.rastrewin.com (registro A/AAAA) apontando para a VM, e o Caddy central
# na mesma rede Docker do container (CADDY_NETWORK, padrão "caddy").
vsl.rastrewin.com {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy vsl-rastrewin:8080
}
