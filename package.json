{
  "name": "track.rastrewin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "create-admin": "tsx --env-file=.env scripts/create-admin.ts",
    "test:rls": "tsx --env-file=.env scripts/test-rls.ts",
    "scripts:build": "esbuild scripts/migrate.ts scripts/create-admin.ts scripts/delete-user.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist-scripts --out-extension:.js=.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "delete-user": "tsx --env-file=.env scripts/delete-user.ts",
    "geo:download": "sh scripts/geo-download.sh",
    "tracker:build": "esbuild src/tracker/trck.ts --bundle --minify --format=iife --target=es2019 --legal-comments=none --outfile=public/t.js",
    "predev": "npm run tracker:build",
    "prebuild": "npm run tracker:build",
    "test": "tsx --conditions=react-server --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "maxmind": "^5.0.8",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
