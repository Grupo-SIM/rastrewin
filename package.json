{
	"name": "rastrewin",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"backend",
		"frontend",
		"track",
		"vsl"
	],
	"scripts": {
		"build": "turbo build",
		"check-types": "turbo check-types",
		"commit": "git add . && bun committier ai",
		"db:push": "bun --cwd backend db:push",
		"db:seed": "bun --cwd backend db:seed",
		"db:up": "docker compose up -d",
		"dev": "turbo dev",
		"dev:backend": "turbo dev --filter backend",
		"dev:frontend": "turbo dev --filter frontend",
		"dev:track": "turbo dev --filter track",
		"dev:vsl": "turbo dev --filter vsl",
		"format": "bun fmt",
		"prepare": "bun run ./prepare.ts || true",
		"start": "turbo start",
		"test": "turbo test",
		"format:check": "bun fmt --check",
		"lint": "bun run lint:biome . && bun run lint:eslint .",
		"lint:biome": "bunx biome check --formatter-enabled=false --diagnostic-level=error",
		"lint:eslint": "bunx eslint --quiet",
		"lint:fix": "bun run lint:biome --write --unsafe . && bun run lint:eslint --fix . && bun run format"
	},
	"devDependencies": {
		"@biomejs/biome": "~2.4.16",
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@commitlint/types": "^20.5.0",
		"@eslint/js": "^10.0.1",
		"@hyoretsu/configs": "1.2.33",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.1",
		"committier": "^0.2.3",
		"eslint": "^10.4.1",
		"eslint-config-biome": "^2.1.3",
		"lefthook": "^2.1.9",
		"lint-staged": "^16.4.0",
		"turbo": "^2.9.16",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1"
	}
}
