{
  "name": "vsl-rastrewin",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "typecheck": "bun run --cwd frontend typecheck",
    "test": "bun run --cwd frontend test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2"
  }
}
