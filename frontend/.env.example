# Variáveis do frontend (rastrewin.com). Nenhuma é segredo: as NEXT_PUBLIC_ vão para o navegador e
# ficam fixadas no BUILD da imagem (o CD passa NEXT_PUBLIC_API_URL como build-arg, da variável do repositório).

# URL da API. Em produção: https://api.rastrewin.com. Sem ela vale /api, que o Next repassa para API_INTERNAL_URL.
NEXT_PUBLIC_API_URL=/api

# Para onde o rewrite /api/* aponta (dev). Em produção o compose usa http://backend:3011.
API_INTERNAL_URL=http://localhost:3011

# Track (t.js, Pixel e GA4). No build de produção, sem ela, vale https://track.rastrewin.com;
# no dev, sem ela, nada de rastreamento é carregado.
# NEXT_PUBLIC_TRACK_URL=http://localhost:3001

# Botão "Encerrar em 10s" do /admin: só para testes. Nunca em produção.
# NEXT_PUBLIC_ENABLE_TEST_TOOLS=true
