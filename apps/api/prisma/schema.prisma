generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  cpf           String
  phone         String
  city          String
  pix           String?
  plan          String
  role          String    @default("USER") // USER | ADMIN
  password      String?   // hash bcrypt; definido quando o pagamento é confirmado (envia por e-mail)
  status        String    @default("PENDING") // PENDING | ACTIVE | EXPIRED
  paidAt        DateTime?
  expiresAt     DateTime? // paidAt + 1 ano; vencido sem renovar = volta pra tela de assinatura expirada
  simpayOrderId String?   @unique // orderId da última cobrança aprovada (idempotência por renovação)
  phoneVerified Boolean   @default(false) // validado por OTP reverso via WhatsApp
  otpCode       String?   // código que o usuário precisa mandar pro WhatsApp do rastrewin
  resetCodeHash      String?   // HMAC do código de 6 dígitos enviado por e-mail na recuperação de senha
  resetCodeExpiresAt DateTime?
  resetAttempts      Int       @default(0)
  createdAt     DateTime  @default(now())
  entries       Entry[]
}

model Setting {
  key   String @id
  value String
}

model Raffle {
  id           String   @id @default(cuid())
  title        String
  prize        String
  site         String
  siteColor    String
  siteEmoji    String
  seed         Int
  baseCount    Int
  endsAt       DateTime
  winnerName   String?
  winnerUserId String?
  winnerIneligible Boolean @default(false) // ganhou mas não recebe: algum critério não foi cumprido
  ineligibleReason String?
  createdAt    DateTime @default(now())
  entries      Entry[]

  @@index([endsAt])
}

/// Posição atual na lista data/raffles.json (20 mil sorteios, percorrida em ciclo).
model FeedState {
  key       String   @id
  position  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Entry {
  id        String   @id @default(cuid())
  userId    String
  raffleId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  raffle    Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([userId, raffleId])
}
