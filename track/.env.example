# Copie para .env e preencha. NUNCA commite o .env.
# Regra do projeto: o env guarda só infraestrutura do banco e segredos de servidor.
# Credenciais de Meta/GA4/webhook são configuradas PELO PAINEL (cifradas no banco).
# Nada aqui usa NEXT_PUBLIC_ — tudo é lido só no servidor.
#
# Gere senhas/chaves com:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# ---------------------------------------------------------------- banco
# Senha do superusuário do Postgres (só o docker-compose e a migração usam)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# Conexão do APP: sempre o usuário app_login (sem privilégios próprios).
# A senha do app_login é definida por `npm run db:migrate` a partir desta URL (24+ caracteres).
# Dentro do docker compose, o host é "db". Rodando `npm run dev` no seu Mac, use "localhost".
DATABASE_URL=postgres://app_login:troque-esta-senha-longa-do-app-login@localhost:5432/rastrewin

# Conexão do DONO do banco — usada SÓ pela migração e pelo teste de RLS (nunca pelo app).
MIGRATION_DATABASE_URL=postgres://postgres:troque-esta-senha@localhost:5432/rastrewin

# ---------------------------------------------------------------- segredos do servidor
# Chave mestra da cifra pgcrypto dos tokens/api_secret. Se perder, os segredos salvos precisam ser recadastrados.
ENCRYPTION_KEY=
# Segredo das sessões do login do painel
BETTER_AUTH_SECRET=

# URL pública do app (ex.: https://track.seudominio.com)
APP_URL=http://localhost:3000
