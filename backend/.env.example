DATABASE_URL="postgresql://sorteio:sorteio@localhost:5436/sorteio?schema=public"
PORT=3011
WEB_ORIGIN=http://localhost:3000

# Checkout simpay — um link por plano, lido pelo nome SIMPAY_CHECKOUT_URL_<PLANO> (plans.ts)
SIMPAY_CHECKOUT_URL_BASICO=changeme
SIMPAY_CHECKOUT_URL_PRO=changeme
SIMPAY_CHECKOUT_URL_VIP=changeme

# SimIntPay (plataforma rastrewin). O webhook de vendas chega em POST /payments/webhook
# (https://api.rastrewin.com/payments/webhook), assinado com HMAC-SHA256 em x-simintpay-signature.
# SIMPAY_WEBHOOK_SECRET = o MESMO WEBHOOK_SECRET cadastrado na plataforma no SimIntPay.
# SIMPAY_INBOUND_TOKEN = INBOUND_TOKEN da plataforma (header x-access-token), para chamadas futuras à API do SimIntPay.
SIMPAY_WEBHOOK_SECRET=changeme
SIMPAY_INBOUND_TOKEN=changeme

# Repasse das vendas ao track (track.rastrewin.com › Configurações › Webhook de vendas › Gerar segredo).
# Sem as duas, o repasse fica desligado (padrão no dev). Local: http://localhost:<porta-do-track>/api/webhook/compra
TRACK_WEBHOOK_URL=
TRACK_WEBHOOK_SECRET=

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Conta admin única (rode `bun run db:seed-admin` para criar/resetar)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Número exibido no modal de verificação de telefone (OTP reverso via WhatsApp)
WHATSAPP_OTP_NUMBER=
