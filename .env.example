# .env usado pelo docker-compose.yml no deploy (Komodo). WEB_ORIGIN já é fixado no compose.
PORT=3011

# Banco de prod: variável POSTGRES_URL do Komodo (postgresql://user:senha@postgresql:5432)
# + nome do banco. O Komodo interpola [[POSTGRES_URL]] no deploy.
DATABASE_URL=[[POSTGRES_URL]]/rastrewin?schema=public

# Checkout simpay — um link por plano. Enquanto Pro/VIP não têm link próprio no
# painel simpay, pode repetir a mesma URL nas três; depois é só trocar aqui, sem deploy de código.
SIMPAY_CHECKOUT_URL_BASICO=https://checkout.simintermediacoes.com/?simLinkCode=14b8ff1b-ae62-41b6-9f23-c8bc4aae3149e
SIMPAY_CHECKOUT_URL_PRO=https://checkout.simintermediacoes.com/?simLinkCode=14b8ff1b-ae62-41b6-9f23-c8bc4aae3149e
SIMPAY_CHECKOUT_URL_VIP=https://checkout.simintermediacoes.com/?simLinkCode=14b8ff1b-ae62-41b6-9f23-c8bc4aae3149e

# SimIntPay (plataforma rastrewin). O webhook de vendas chega em POST /payments/webhook
# (https://api.rastrewin.com/payments/webhook), assinado com HMAC-SHA256 em x-simintpay-signature.
# SIMPAY_WEBHOOK_SECRET = o MESMO WEBHOOK_SECRET cadastrado na plataforma no SimIntPay.
# SIMPAY_INBOUND_TOKEN = INBOUND_TOKEN da plataforma (header x-access-token), para chamadas futuras à API do SimIntPay.
SIMPAY_WEBHOOK_SECRET=cole-aqui-o-webhook-secret-da-plataforma
SIMPAY_INBOUND_TOKEN=cole-aqui-o-inbound-token-da-plataforma

# Repasse das vendas ao track (track.rastrewin.com › Configurações › Webhook de vendas › Gerar segredo).
# Sem as duas, o repasse fica desligado.
TRACK_WEBHOOK_URL=https://track.rastrewin.com/api/webhook/compra
TRACK_WEBHOOK_SECRET=cole-aqui-o-segredo-gerado-no-track

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cole-aqui-um-secret-forte

SMTP_HOST=smtp.seu-provedor.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@seu-dominio.com.br
SMTP_PASSWORD=cole-aqui
SMTP_FROM_EMAIL=noreply@seu-dominio.com.br

# Conta admin única — rode `npm run db:seed-admin` (dentro do container) para criar/resetar
ADMIN_EMAIL=admin@seu-dominio.com.br
ADMIN_PASSWORD=cole-aqui-a-senha

# Número exibido no modal de verificação de telefone (OTP reverso via WhatsApp, instância Evolution API "rastrewin")
WHATSAPP_OTP_NUMBER=+55 00 00000-0000

# Segredo do webhook do WhatsApp (POST /whatsapp/webhook). Sem ele a rota recusa tudo. Cadastre o MESMO valor na
# Evolution API, como header "x-webhook-secret" ou como "?token=<segredo>" na URL do webhook.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_WEBHOOK_SECRET=cole-aqui-um-segredo-forte

# Certificado TLS do SMTP: SEMPRE verificado. Se o certificado do servidor de e-mail é do hostname real dele
# (hospedagem compartilhada, ex.: pro120.dns-pro.com.br) e não do SMTP_HOST, informe esse hostname aqui.
SMTP_TLS_SERVERNAME=

# Segredos próprios (opcionais; sem eles valem o JWT_SECRET, com um prefixo diferente por uso):
# RESET_CODE_SECRET=
# PRIVACY_TOKEN_SECRET=

# O seed da conta admin roda a cada boot e NÃO muda a senha de um admin que já existe. Para resetar a senha
# (e o 2FA), suba UMA vez com ADMIN_RESET_PASSWORD=true e depois tire.
# ADMIN_RESET_PASSWORD=true

# Botão "Encerrar em 10s" do /admin e a rota por trás dele: só para testes. Em produção ficam desligados.
# ENABLE_TEST_TOOLS=true
