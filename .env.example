# .env usado pelo docker-compose.yml no deploy (Komodo). DATABASE_URL e WEB_ORIGIN
# já são fixados no compose (rede interna db/api); só o resto precisa vir daqui.
PORT=3011

# Checkout simpay — um link por plano. Enquanto Pro/VIP não têm link próprio no
# painel simpay, pode repetir a mesma URL nas três; depois é só trocar aqui, sem deploy de código.
SIMPAY_CHECKOUT_URL_BASICO=https://checkout.simintermediacoes.com/?simLinkCode=14b8ff1b-ae62-41b6-9f23-c8bc4aae3149e
SIMPAY_CHECKOUT_URL_PRO=https://checkout.simintermediacoes.com/?simLinkCode=14b8ff1b-ae62-41b6-9f23-c8bc4aae3149e
SIMPAY_CHECKOUT_URL_VIP=https://checkout.simintermediacoes.com/?simLinkCode=14b8ff1b-ae62-41b6-9f23-c8bc4aae3149e
SIMPAY_WEBHOOK_TOKEN=cole-aqui-o-token-do-simpay

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cole-aqui-um-secret-forte

SMTP_HOST=mail.jbmidia.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@jbmidia.com
SMTP_PASSWORD=cole-aqui
SMTP_FROM_EMAIL=noreply@jbmidia.com

# Conta admin única — rode `npm run db:seed-admin` (dentro do container) para criar/resetar
ADMIN_EMAIL=contatosimintermediacoes@gmail.com
ADMIN_PASSWORD=cole-aqui-a-senha

# Número exibido no modal de verificação de telefone (OTP reverso via WhatsApp,
# instância Evolution API "rastrewin" em api-whatsapp.jbmidia.com)
WHATSAPP_OTP_NUMBER=+55 68 99246-0595
