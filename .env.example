# Copie para .env e preencha. NUNCA commite o .env.
# Regra do projeto: o env guarda só infraestrutura e segredos de servidor.
# Credenciais de Meta/GA4/webhook são configuradas PELO PAINEL (cifradas no banco).
# Nada aqui usa NEXT_PUBLIC_ — tudo é lido só no servidor.

# Banco (conexão do app). Na Fase 2 passa a usar o papel app_login.
# Rodando via docker compose, troque "localhost" por "db" (nome do serviço).
DATABASE_URL=postgres://postgres:troque-esta-senha@localhost:5432/rastrewin

# Só usado pelo docker-compose para criar o banco
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# Chave mestra da cifra pgcrypto dos segredos (Fase 2). Gere com: openssl rand -base64 48
ENCRYPTION_KEY=

# Segredo das sessões do login do painel (Fase 2). Gere com: openssl rand -base64 48
BETTER_AUTH_SECRET=

# URL pública do app (ex.: https://track.seudominio.com)
APP_URL=http://localhost:3000
