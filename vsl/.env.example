# O site é 100% estático e NÃO tem segredos. Os conteúdos editáveis (vídeo, tempo do botão, textos)
# ficam em frontend/src/config/page-config.ts.
#
# Variáveis de DEPLOY (Environment do Komodo), nenhuma é sensível:

# Nome da rede Docker compartilhada com o caddy-docker-proxy.
CADDY_NETWORK=caddy

# Versão da imagem no GHCR: latest (último push na main) ou sha-<commit> para fixar/voltar uma versão.
VSL_IMAGE_TAG=latest
